# Mioym Equites — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
#
# Priority for most settings: settings_tbl (DB) > environment variable > built-in default.
# Exception: DB connection itself reads ONLY from here (or the defaults in db.php),
# because the database must connect before settings_tbl can be read.

# --- Database (required for db.php connection) ---
DB_HOST=localhost
DB_NAME=webinar_db
DB_USER=mioymadmin
DB_PASS=change-me

# --- Email (Brevo API). Used only when settings_tbl.brevo_api_key is empty ---
BREVO_API_KEY=

# --- reCAPTCHA. Used when the matching settings_tbl key is empty ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Cron secrets. Each used only when settings_tbl.cron_secret_<name> is empty ---
# Matches get_cron_secret('send_emails') -> CRON_SECRET_SEND_EMAILS
CRON_SECRET_SEND_EMAILS=
# Matches get_cron_secret('reminders') -> CRON_SECRET_REMINDERS
CRON_SECRET_REMINDERS=

# --- Sessions. Set to 1 to force secure cookies (requires HTTPS) ---
FORCE_SECURE_COOKIE=1
